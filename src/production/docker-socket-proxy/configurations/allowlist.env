# The Docker API sections the proxy forwards to the daemon, for the swarm scheduler exporter.
# Every ACL variable of the image is set explicitly, relying on no default: the image enables EVENTS and VERSION by default.

# Needed by the exporter. PING is how the client negotiates the API version, so VERSION stays off.
PING=1
EVENTS=1
SERVICES=1
NODES=1
TASKS=1
# CONTAINERS: only for the exporter's container metrics, which the stack does not use.
CONTAINERS=0

# Not needed: denied.
ALLOW_RESTARTS=0
ALLOW_START=0
ALLOW_STOP=0
AUTH=0
BUILD=0
COMMIT=0
CONFIGS=0
DISTRIBUTION=0
EXEC=0
GRPC=0
IMAGES=0
INFO=0
NETWORKS=0
PLUGINS=0
# POST: 0 denies every method but GET (and HEAD), whatever the section.
POST=0
SECRETS=0
SESSION=0
SWARM=0
SYSTEM=0
VERSION=0
VOLUMES=0

# Referenced by the image's haproxy.cfg but not given a default in its environment: set to 0 anyway.
ALLOW_PAUSE=0
ALLOW_UNPAUSE=0
